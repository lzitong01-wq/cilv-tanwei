部署验证-*/

# ---- 本地与编辑器 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# ---- 机密 ----
.env
.env.local
*.pem
*.key
/etc/cilv/deploy.env

# ---- 构建期第三方语料源（不入库，可重新下载）----
.workbuddy/reference/

# ---- AI 工作记忆（会话日志，内部记录，不对外）----
.workbuddy/memory/

